<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intranet | <%= companyName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; }
        input:-webkit-autofill { -webkit-box-shadow: 0 0 0 1000px white inset; }
    </style>
</head>
<body class="brand-theme h-screen flex overflow-hidden bg-white">

    <!-- ─── LADO IZQUIERDO: Imagen corporativa ─────────────────────────────── -->
    <div class="hidden md:block md:w-[62%] relative overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"
             style="background-image: url('https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&q=80&w=1600');"></div>
        <!-- Overlay sutil para integrar con el blanco del lado derecho -->
        <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-white to-transparent z-10"></div>
        <div class="absolute inset-0 bg-black/10"></div>
    </div>

    <!-- ─── LADO DERECHO: Formulario de login ─────────────────────────────── -->
    <div class="w-full md:w-[38%] flex flex-col justify-between py-10 px-10 md:px-14 bg-white z-10 relative">

        <!-- Logo -->
        <div class="flex items-center space-x-3">
            <div class="flex items-center">
                <img src="/img/logo-vtf.png" alt="<%= companyName %>" class="login-brand-logo">
                <span class="ml-3 text-slate-800 font-bold text-lg tracking-tight leading-none"><%= companyName %></span>
            </div>
        </div>

        <!-- Formulario central -->
        <div class="w-full max-w-[340px] mx-auto space-y-6">

            <% if (locals.error) { %>
                <div class="text-sm text-red-600 bg-red-50 border border-red-200 px-4 py-3 rounded-md">
                    <%= error %>
                </div>
            <% } %>

            <% if (entraEnabled) { %>
                <!-- ══ MODO PRODUCCIÓN: Entra ID Real ══════════════════════════════ -->
                <div>
                    <h2 class="text-slate-700 text-sm font-normal mb-4">
                        Ingresa tu usuario o correo corporativo:
                    </h2>

                    <form id="entra-login-form" action="/login" method="POST" class="space-y-3">
                        <input
                            type="text"
                            name="email"
                            required
                            autofocus
                            autocomplete="username"
                            placeholder="usuario o usuario<%= companyDomain %>"
                            class="w-full px-3 py-2 border border-slate-300 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500 text-sm text-slate-800 rounded-sm transition-colors"
                        >

                        <label class="flex items-center space-x-2 text-sm text-slate-600 select-none cursor-pointer">
                            <input type="checkbox" name="remember" class="rounded border-slate-300 text-red-600 focus:ring-red-500 focus:ring-1">
                            <span>Mantener la sesión iniciada</span>
                        </label>

                        <button type="submit"
                                class="w-auto px-6 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold text-sm rounded-sm transition-colors shadow-sm">
                            Iniciar sesión
                        </button>
                    </form>
                    <div id="entra-login-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 px-4 py-3 rounded-md" role="alert"></div>

                    <p class="mt-5 text-sm text-slate-600">
                        Serás redirigido a Microsoft para ingresar tu contraseña y MFA.
                        <a href="https://passwordreset.microsoftonline.com/" target="_blank"
                           class="text-red-600 hover:underline">¿Olvidaste tu contraseña?</a>
                    </p>
                </div>

            <% } else { %>
                <!-- ══ MODO DEMO (ENTRA_ID_ENABLED=false) ═════════════════════════ -->
                <div>
                    <h2 class="text-slate-700 text-sm font-normal mb-4">
                        Ingresa tu correo corporativo <%= companyDomain %>:
                    </h2>

                    <form action="/login/demo" method="POST" class="space-y-3">
                        <div>
                            <input
                                type="email"
                                name="email"
                                id="demo-email"
                                required
                                autofocus
                                placeholder="usuario<%= companyDomain %>"
                                class="w-full px-3 py-2 border border-slate-300 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500 text-sm text-slate-800 rounded-sm transition-colors"
                            >
                        </div>

                        <label class="flex items-center space-x-2 text-sm text-slate-600 select-none cursor-pointer">
                            <input type="checkbox" name="remember" class="rounded border-slate-300 text-red-600 focus:ring-red-500 focus:ring-1">
                            <span>Mantener la sesión iniciada</span>
                        </label>

                        <button type="submit"
                                class="px-6 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold text-sm rounded-sm transition-colors shadow-sm">
                            Iniciar sesión
                        </button>
                    </form>

                    <!-- Accesos rápidos de demo (discretos) -->
                    <div class="mt-6 pt-5 border-t border-slate-100">
                        <p class="text-xs text-slate-400 mb-2 font-medium uppercase tracking-wide">
                            Acceso rápido (demo)
                        </p>
                        <div class="space-y-1.5">
                            <button type="button" onclick="setEmail('colaborador<%= companyDomain %>')"
                                    class="text-xs text-slate-500 hover:text-red-600 transition-colors block text-left">
                                colaborador<%= companyDomain %> — Público general
                            </button>
                            <button type="button" onclick="setEmail('soporte-ti<%= companyDomain %>')"
                                    class="text-xs text-slate-500 hover:text-red-600 transition-colors block text-left">
                                soporte-ti<%= companyDomain %> — Grupo TI
                            </button>
                            <button type="button" onclick="setEmail('admin<%= companyDomain %>')"
                                    class="text-xs text-slate-500 hover:text-red-600 transition-colors block text-left">
                                admin<%= companyDomain %> — Administrador
                            </button>
                        </div>
                    </div>
                </div>
            <% } %>

        </div>

        <!-- Pie de página -->
        <div class="flex items-center justify-start space-x-4 text-xs text-red-500">
            <a href="#" class="hover:underline">Políticas de privacidad</a>
            <a href="#" class="hover:underline">Soporte TI</a>
        </div>

    </div>

    <% if (entraEnabled) { %>
    <script>
        const entraLoginForm = document.getElementById('entra-login-form');
        const entraLoginError = document.getElementById('entra-login-error');

        entraLoginForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            entraLoginError.textContent = '';
            entraLoginError.classList.add('hidden');

            try {
                const response = await fetch(entraLoginForm.action, {
                    method: entraLoginForm.method,
                    body: new URLSearchParams(new FormData(entraLoginForm)),
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin'
                });
                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.error || 'No fue posible iniciar sesión.');
                }

                window.location.assign(result.redirectUrl);
            } catch (error) {
                entraLoginError.textContent = error.message || 'No fue posible conectar con el servidor.';
                entraLoginError.classList.remove('hidden');
            }
        });
    </script>
    <% } else { %>
    <script>
        function setEmail(email) {
            document.getElementById('demo-email').value = email;
        }
    </script>
    <% } %>

</body>
</html>
