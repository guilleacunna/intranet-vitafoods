# ==============================================================================
# CONFIGURACIÓN DE PROXY INVERSO CORPORATIVO (NGINX)
# ==============================================================================
# Este archivo muestra cómo conectar una aplicación detrás de un Reverse Proxy corporativo (DMZ / Edge),
# proporcionando terminación SSL/TLS, mitigación DDoS, WAF y enrutamiento seguro.
# ==============================================================================

# 1. Definición de limitadores de tasa a nivel de Proxy perimetral
limit_req_zone $binary_remote_addr zone=intranet_limit:10m rate=15r/s;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;

# 2. Servidores Upstream de la aplicación en la red interna
upstream intranet_backend {
    server 127.0.0.1:3000 max_fails=3 fail_timeout=10s;
    # En alta disponibilidad:
    # server 192.0.2.101:3000 weight=2;
    # server 192.0.2.102:3000 weight=2;
    keepalive 32;
}

# 3. Redirección forzada de HTTP no seguro a HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name intranet.example.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

# 4. Servidor HTTPS Corporativo Seguro
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name intranet.example.com;

    # Certificados SSL/TLS (Cifrado robusto corporativo)
    ssl_certificate /etc/ssl/certs/intranet_example_com.crt;
    ssl_certificate_key /etc/ssl/private/intranet_example_com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Encabezados de Seguridad Perimetral
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Logs de Auditoría de Ciberseguridad
    access_log /var/log/nginx/intranet_access.log combined;
    error_log /var/log/nginx/intranet_error.log warn;

    # Límite de carga de peticiones (Previene desbordamiento de búfer)
    client_max_body_size 10M;

    # Enrutamiento hacia la aplicación Node.js / Express
    location / {
        limit_req zone=intranet_limit burst=20 nodelay;

        proxy_pass http://intranet_backend;
        proxy_http_version 1.1;

        # Conexiones persistentes
        proxy_set_header Connection "";

        # Cabeceras de Proxy Inverso que Express lee mediante 'trust proxy'
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Tiempos de espera de proxy
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Protección reforzada específica para la ruta de login
    location /login {
        limit_req zone=login_limit burst=5 nodelay;

        proxy_pass http://intranet_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
